# Postgres (хранилище NocoDB)
POSTGRES_USER=crm
POSTGRES_PASSWORD=change-me
POSTGRES_DB=crm

# NocoDB
NC_PORT=8080
NC_ADMIN_EMAIL=admin@crm.local
NC_ADMIN_PASSWORD=ChangeMe123!
NC_AUTH_JWT_SECRET=change-me-long-random-string

# Доступ приложения к NocoDB (заполняется после `pnpm migrate --bootstrap`)
NOCODB_URL=http://localhost:8080
NOCODB_API_TOKEN=
NOCODB_BASE_TITLE=crm

# Redis
REDIS_URL=redis://localhost:6379

# API
API_PORT=3000
SESSION_SECRET=change-me-long-random-string
# Каталог для фото (локально; в Docker задаётся в docker-compose.yml)
FILES_DIR=./data/files

# Telegram-бот уведомлений (необязательно; токен выдаёт @BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Веб (Caddy). Для продакшена: SITE_ADDRESS=crm.example.com
SITE_ADDRESS=:80
WEB_PORT=80
